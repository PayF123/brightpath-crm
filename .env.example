# BrightPath CRM - Client-Side Environment Variables
# Copy this file to .env and fill in your Supabase project credentials.
# Note: Variables prefixed with VITE_ are bundled into browser client code.
# NEVER put service-role keys or database passwords in this file.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-client-anon-key
